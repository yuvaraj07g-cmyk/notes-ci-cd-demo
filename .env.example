# Copy this file to .env and fill in YOUR values. .env is never committed to Git.

# Your real database: the main branch of your Neon project
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# A separate database just for tests: a second branch of the same Neon project
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST-TEST.neon.tech/neondb?sslmode=require
